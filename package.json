{
  "name": "@jelto/tauri",
  "version": "1.1.3",
  "description": "Jelto analytics bindings for the Tauri 2 desktop plugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usejelto/tauri-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/usejelto/tauri-sdk/issues"
  },
  "homepage": "https://jelto.io/docs/sdk/tauri",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
